# Keep all provider keys server-side. Never prefix these with NEXT_PUBLIC_. Add only the providers you want to enable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Backwards-compatible optional default for Groq deployments
DEFAULT_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional security and analytics integrations
ARCJET_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SITE_URL=https://axiom-groq-chat.vercel.app
